  "item": [
    {
      "name": "1. Основи",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код стану 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Заголовок Cache-Control: no-store\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
                  "});",
                  "pm.test(\"Наявні службові заголовки Server-Timing та X-Request-Id\", () => {",
                  "  pm.response.to.have.header(\"Server-Timing\");",
                  "  pm.response.to.have.header(\"X-Request-Id\");",
                  "});",
                  "pm.test(\"Тіло містить status: ok, uptime та версію Node.js\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(\"ok\");",
                  "  pm.expect(body.uptime).to.be.a(\"number\");",
                  "  pm.expect(body.node).to.include(\"v24\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
