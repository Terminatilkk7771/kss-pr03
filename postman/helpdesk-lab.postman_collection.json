          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код стану 200\", () => pm.response.to.have.status(200));",
                  "const login = pm.response.json();",
                  "pm.collectionVariables.set(\"studentToken\", login.accessToken);",
                  "pm.test(\"Токен Bearer отримано та збережено у змінну studentToken\", () => {",
                  "  pm.expect(login.accessToken).to.be.a(\"string\").and.not.empty;",
