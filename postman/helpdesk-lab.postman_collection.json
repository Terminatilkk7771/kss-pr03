    {
      "name": "3. Заявки: читання",
      "item": [
        {
          "name": "Список заявок",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?page=1&pageSize=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "4"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код стану 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Наявні заголовки ETag, Cache-Control і Vary\", () => {",
                  "  pm.response.to.have.header(\"ETag\");",
                  "  pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"private, no-cache\");",
                  "  pm.expect(pm.response.headers.get(\"Vary\")).to.include(\"Accept\");",
                  "});",
                  "pm.test(\"Тіло містить масив items (4 заявки) та метадані пагінації\", () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.items).to.be.an(\"array\").with.lengthOf(4);",
                  "  pm.expect(data.page).to.eql(1);",
                  "  pm.expect(data.pageSize).to.eql(4);",
                  "  pm.expect(data.total).to.be.at.least(6);",
                  "});"
                ]
              }
            }
          ]
        },
